<UserControl x:Class="MobileView_Wpf.Views.UserControls.TitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MobileView_Wpf.Views.UserControls"
             xmlns:behaviors="clr-namespace:MobileView_Wpf.Infrastructure.Behaviors"
             mc:Ignorable="d" 
             d:DesignHeight="30" d:DesignWidth="337">
    <StackPanel 
        Orientation="Horizontal" 
        FlowDirection="RightToLeft"
        Background="LightGray" 
        Height="30"
        behaviors:WindowDrag.IsDragEnabled="True">
        <Button 
            VerticalAlignment="Center"
            Content="Minimize" 
            Width="75" />
        <Button 
            VerticalAlignment="Center"
            Content="Maximize" 
            Width="75" />
        <Button 
            VerticalAlignment="Center"
            Content="Close" 
            Width="75" />
    </StackPanel>
</UserControl>
